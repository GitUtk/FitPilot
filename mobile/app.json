{
  "expo": {
    "name": "FitPilot",
    "slug": "fitpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gitutk.fitpilot",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow FitPilot to access the camera for real-time biomechanical analysis and form correction."
      }
    },
    "android": {
      "package": "com.gitutk.fitpilot",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FitPilot to access the camera for real-time biomechanical analysis and form correction.",
          "microphonePermission": "Allow FitPilot to access the microphone for audio instructions."
        }
      ]
    ]
  }
}
